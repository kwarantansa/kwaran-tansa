rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SISKA-SIKAP Realtime Cloud Database Rules
    // Mengizinkan sinkronisasi realtime multi-perangkat untuk pengurus & publik

    // Konektivitas test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Koleksi data Gugus Depan se-Tanah Sareal
    match /gudep_list/{gudepId} {
      allow read, write: if true;
    }

    // Koleksi data Anggota & Pembina Pramuka
    match /members_list/{memberId} {
      allow read, write: if true;
    }

    // Koleksi pengajuan NUP
    match /nup_list/{nupId} {
      allow read, write: if true;
    }

    // Koleksi pengajuan KTA kolektif gudep
    match /kta_batches/{batchId} {
      allow read, write: if true;
    }

    // Koleksi arsip digital dokumen Kwarran
    match /archives_list/{archiveId} {
      allow read, write: if true;
    }

    // Koleksi laporan semester gudep
    match /semester_reports/{reportId} {
      allow read, write: if true;
    }

    // Koleksi akun pengurus Kwarran
    match /pengurus_list/{pengurusId} {
      allow read, write: if true;
    }

    // Pengaturan umum dan kontak sekretariat
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // Fallback default
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

